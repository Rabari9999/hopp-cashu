-- Version 11 → 12: sync across devices over Nostr (ADR 0021, stage 5).
CREATE TABLE sync_entry (
    doc TEXT NOT NULL,
    key TEXT NOT NULL,
    json TEXT NOT NULL,
    updated_at INTEGER NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (doc, key)
);

CREATE TABLE sync_doc (
    doc TEXT PRIMARY KEY NOT NULL,
    fetched_at INTEGER,
    published_up_to INTEGER
);
