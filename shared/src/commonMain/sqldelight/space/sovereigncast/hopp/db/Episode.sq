-- An item of a subscribed feed (ADR 0013). meta_json is the parsed
-- model.Episode; position, played, inbox and downloads are the listener's.
CREATE TABLE episode (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    podcast_id INTEGER NOT NULL,
    guid TEXT NOT NULL,
    title TEXT,
    published_at INTEGER,
    duration_seconds INTEGER,
    image_url TEXT,
    enclosure_url TEXT,
    chapters_url TEXT,
    meta_json TEXT NOT NULL,
    position_ms INTEGER NOT NULL DEFAULT 0,
    played INTEGER NOT NULL DEFAULT 0,
    last_played_at INTEGER,
    in_inbox INTEGER NOT NULL DEFAULT 0,
    first_seen_at INTEGER NOT NULL,
    -- DownloadState: 0 none, 1 queued, 2 downloading, 3 done, 4 failed.
    download_state INTEGER NOT NULL DEFAULT 0,
    download_path TEXT,
    -- Version 2 (migrations/1.sqm): when it was played (downloads go 24 h
    -- later), its size on disk, and whether the listener asked for it —
    -- a requested download may use mobile data, an automatic one may not.
    played_at INTEGER,
    download_size INTEGER,
    download_manual INTEGER NOT NULL DEFAULT 0,
    -- Version 4 (migrations/3.sqm): when the listener made it a favourite;
    -- null = not one (device feedback 2026-10-11).
    favorite_at INTEGER,
    UNIQUE (podcast_id, guid)
);

CREATE INDEX episode_podcast_idx ON episode(podcast_id, published_at);
CREATE INDEX episode_inbox_idx ON episode(in_inbox, published_at);

-- Only what the feed knows; a known episode keeps the listener's state.
insertIfNew:
INSERT OR IGNORE INTO episode (podcast_id, guid, title, published_at, duration_seconds, image_url, enclosure_url, chapters_url, meta_json, in_inbox, first_seen_at, download_state)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateFromFeed:
UPDATE episode SET title = ?, published_at = ?, duration_seconds = ?, image_url = ?, enclosure_url = ?, chapters_url = ?, meta_json = ?
WHERE podcast_id = ? AND guid = ?;

guidsOfPodcast:
SELECT guid FROM episode WHERE podcast_id = ?;

selectById:
SELECT * FROM episode WHERE id = ?;

selectByGuid:
SELECT * FROM episode WHERE podcast_id = ? AND guid = ?;

selectByPodcast:
SELECT * FROM episode WHERE podcast_id = ? ORDER BY published_at DESC, id DESC;

-- A page of the show's episodes — the show page loads 20 at a time.
selectByPodcastPage:
SELECT * FROM episode WHERE podcast_id = ? ORDER BY published_at DESC, id DESC LIMIT ?;

countByPodcast:
SELECT count(*) FROM episode WHERE podcast_id = ?;

-- The library's numbers per show: all its episodes, and how many are new (in "New").
countsPerPodcast:
SELECT podcast_id, count(*) AS total, sum(in_inbox) AS fresh FROM episode GROUP BY podcast_id;

-- "New" (ADR 0012): what arrived since the listener last looked, newest first.
selectInbox:
SELECT e.*, p.title AS podcast_title, p.image_url AS podcast_image_url
FROM episode e JOIN podcast p ON p.id = e.podcast_id
WHERE e.in_inbox = 1
ORDER BY e.published_at DESC, e.id DESC;

-- "Continue listening": started, not finished.
selectInProgress:
SELECT e.*, p.title AS podcast_title, p.image_url AS podcast_image_url
FROM episode e JOIN podcast p ON p.id = e.podcast_id
WHERE e.position_ms > 0 AND e.played = 0
ORDER BY e.last_played_at DESC
LIMIT 20;

-- Home: "Recently played" — finished, newest first.
selectRecentlyPlayed:
SELECT e.*, p.title AS podcast_title, p.image_url AS podcast_image_url
FROM episode e JOIN podcast p ON p.id = e.podcast_id
WHERE e.played = 1 AND e.played_at IS NOT NULL
ORDER BY e.played_at DESC
LIMIT ?;

setInbox:
UPDATE episode SET in_inbox = ? WHERE id = ?;

clearInbox:
UPDATE episode SET in_inbox = 0 WHERE in_inbox = 1;

savePosition:
UPDATE episode SET position_ms = ?, last_played_at = ?, in_inbox = 0 WHERE id = ?;

markPlayed:
UPDATE episode SET played = 1, played_at = ?, position_ms = 0, in_inbox = 0 WHERE id = ?;

markUnplayed:
UPDATE episode SET played = 0, played_at = NULL WHERE id = ?;

deleteByPodcast:
DELETE FROM episode WHERE podcast_id = ?;

-- Downloads (ADR 0012) ------------------------------------------------------

requestDownload:
UPDATE episode SET download_state = 1, download_manual = ? WHERE id = ? AND download_state IN (0, 4);

setDownloadState:
UPDATE episode SET download_state = ? WHERE id = ?;

setDownloaded:
UPDATE episode SET download_state = 3, download_path = ?, download_size = ? WHERE id = ?;

clearDownload:
UPDATE episode SET download_state = 0, download_path = NULL, download_size = NULL, download_manual = 0 WHERE id = ?;

-- An app killed mid-download left it "downloading"; the .part file resumes.
resetInterrupted:
UPDATE episode SET download_state = 1 WHERE download_state = 2;

-- What to fetch next: requested ones first, then the newest.
nextDownload:
SELECT * FROM episode
WHERE download_state = 1 AND enclosure_url IS NOT NULL AND (download_manual = 1 OR :includeAuto = 1)
ORDER BY download_manual DESC, published_at DESC
LIMIT 1;

selectDownloads:
SELECT e.*, p.title AS podcast_title, p.image_url AS podcast_image_url
FROM episode e JOIN podcast p ON p.id = e.podcast_id
WHERE e.download_state IN (1, 2, 3, 4)
ORDER BY e.download_state = 3, e.published_at DESC;

downloadedBytes:
SELECT CAST(coalesce(sum(download_size), 0) AS INTEGER) FROM episode WHERE download_state = 3;

-- Played a day ago: the file goes (ADR 0012).
playedDownloadsBefore:
SELECT id, download_path FROM episode WHERE download_state = 3 AND played = 1 AND played_at < ?;

-- Over the storage limit, the oldest unplayed downloads go first.
unplayedDownloadsOldestFirst:
SELECT id, download_path, download_size FROM episode WHERE download_state = 3 AND played = 0
ORDER BY published_at ASC, id ASC;

downloadPathsOfPodcast:
SELECT download_path FROM episode WHERE podcast_id = ? AND download_path IS NOT NULL;

-- Favourites (device feedback 2026-10-11): newest first.
setFavorite:
UPDATE episode SET favorite_at = ? WHERE id = ?;

selectFavorites:
SELECT e.*, p.title AS podcast_title, p.image_url AS podcast_image_url
FROM episode e JOIN podcast p ON p.id = e.podcast_id
WHERE e.favorite_at IS NOT NULL
ORDER BY e.favorite_at DESC;

-- What a show's episode search looks through: title and the feed's description.
selectSearchable:
SELECT id, title, meta_json FROM episode WHERE podcast_id = ?;

-- Home's "From your shows" (device feedback 2026-10-12): per show the newest
-- episode not heard, not started and not new. No window functions — Android 8
-- has SQLite 3.18 — so the newest date per show, joined back.
selectUnheardPerShow:
SELECT e.*, p.title AS podcast_title, p.image_url AS podcast_image_url
FROM episode e JOIN podcast p ON p.id = e.podcast_id
JOIN (
    SELECT podcast_id, max(published_at) AS newest FROM episode
    WHERE played = 0 AND position_ms = 0 AND in_inbox = 0 AND published_at IS NOT NULL
    GROUP BY podcast_id
) n ON n.podcast_id = e.podcast_id AND n.newest = e.published_at
WHERE e.played = 0 AND e.position_ms = 0 AND e.in_inbox = 0
ORDER BY e.published_at DESC;

-- When each show published, newest first — for its rhythm.
selectPublished:
SELECT podcast_id, published_at FROM episode WHERE published_at IS NOT NULL ORDER BY podcast_id, published_at DESC;
