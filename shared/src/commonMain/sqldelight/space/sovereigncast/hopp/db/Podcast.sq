-- A subscribed show (ADR 0013). What the feed says lives in meta_json (the
-- parsed model.Podcast); columns are what is sorted, filtered or ours.
CREATE TABLE podcast (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    feed_url TEXT NOT NULL UNIQUE,
    podcast_guid TEXT,
    title TEXT NOT NULL,
    author TEXT,
    image_url TEXT,
    meta_json TEXT NOT NULL,
    -- Conditional requests: an unchanged feed costs a 304 and is not parsed.
    etag TEXT,
    last_modified TEXT,
    last_checked_at INTEGER,
    last_error TEXT,
    -- Sovereigncast layer (ADR 0002): instance base URL once verified.
    sc_base_url TEXT,
    sc_verified_at INTEGER,
    sc_capabilities_json TEXT,
    subscribed_at INTEGER NOT NULL,
    playback_speed REAL,
    auto_download INTEGER NOT NULL DEFAULT 1,
    -- Version 11 (migrations/10.sqm): the feed's itunes:category, one per line —
    -- the library shows the first and Discover counts them (device feedback 2026-10-19).
    categories TEXT NOT NULL DEFAULT '',
    -- Version 15 (migrations/14.sqm): seconds skipped at an episode's start and end, 0 for none.
    skip_intro_seconds INTEGER NOT NULL DEFAULT 0,
    skip_outro_seconds INTEGER NOT NULL DEFAULT 0,
    -- Version 17 (migrations/16.sqm): every episode published up to this time (seconds) heard,
    -- as of played_through_at — "this and older" or "all" in one, for sync (maintainer 2026-10-30).
    played_through INTEGER,
    played_through_at INTEGER,
    -- Version 20 (migrations/19.sqm): where a "heard up to" found from this device's copy of the feed
    -- starts — another device's may reach further back (review 2026-10-31). Null: from the first.
    played_through_from INTEGER
);

CREATE INDEX podcast_guid_idx ON podcast(podcast_guid);

insert:
INSERT INTO podcast (feed_url, podcast_guid, title, author, image_url, meta_json, etag, last_modified, last_checked_at, subscribed_at, categories)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

lastInsertId:
SELECT last_insert_rowid();

selectAll:
SELECT * FROM podcast ORDER BY title COLLATE NOCASE;

selectById:
SELECT * FROM podcast WHERE id = ?;

-- Whether it may move is decided where it is set (EpisodeRepository): the three go together.
setPlayedThrough:
UPDATE podcast SET played_through = :before, played_through_from = :from, played_through_at = :at WHERE id = :id;

playedThroughOf:
SELECT played_through, played_through_from, played_through_at FROM podcast WHERE id = ?;

selectByFeedUrl:
SELECT * FROM podcast WHERE feed_url = ?;

updateFromFeed:
UPDATE podcast SET podcast_guid = ?, title = ?, author = ?, image_url = ?, meta_json = ?,
    etag = ?, last_modified = ?, last_checked_at = ?, last_error = NULL, categories = ?
WHERE id = ?;

markChecked:
UPDATE podcast SET etag = coalesce(?, etag), last_modified = coalesce(?, last_modified), last_checked_at = ?, last_error = ?
WHERE id = ?;

updateFeedUrl:
UPDATE podcast SET feed_url = ? WHERE id = ?;

delete:
DELETE FROM podcast WHERE id = ?;

setSpeed:
UPDATE podcast SET playback_speed = ? WHERE id = ?;

setAutoDownload:
UPDATE podcast SET auto_download = ? WHERE id = ?;

setSkip:
UPDATE podcast SET skip_intro_seconds = ?, skip_outro_seconds = ? WHERE id = ?;

-- Sovereigncast layer (ADR 0002): the verified instance and what it answered.
setSovereigncast:
UPDATE podcast SET sc_base_url = ?, sc_verified_at = ?, sc_capabilities_json = ? WHERE id = ?;

clearSovereigncast:
UPDATE podcast SET sc_base_url = NULL, sc_verified_at = NULL, sc_capabilities_json = NULL WHERE id = ? AND sc_base_url IS NOT NULL;

selectSovereigncast:
SELECT sc_base_url, sc_verified_at, sc_capabilities_json FROM podcast WHERE id = ?;

-- Home's "at your shows" (device feedback 2026-10-10): every verified show.
selectAllSovereigncast:
SELECT id, title, image_url, sc_base_url, sc_capabilities_json FROM podcast WHERE sc_base_url IS NOT NULL ORDER BY title COLLATE NOCASE;

-- When the last refresh of any show was.
lastChecked:
SELECT max(last_checked_at) AS last FROM podcast;
