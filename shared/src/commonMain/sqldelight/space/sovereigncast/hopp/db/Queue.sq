-- Up next (ADR 0012), in order. The episode playing is not in it.
CREATE TABLE queue (
    episode_id INTEGER PRIMARY KEY NOT NULL,
    sort_key INTEGER NOT NULL
);

selectAll:
SELECT episode_id FROM queue ORDER BY sort_key;

deleteByPodcast:
DELETE FROM queue WHERE episode_id IN (SELECT id FROM episode WHERE podcast_id = ?);

selectItems:
SELECT e.*, p.title AS podcast_title, p.image_url AS podcast_image_url
FROM queue q JOIN episode e ON e.id = q.episode_id JOIN podcast p ON p.id = e.podcast_id
ORDER BY q.sort_key;

minKey:
SELECT coalesce(min(sort_key), 0) FROM queue;

maxKey:
SELECT coalesce(max(sort_key), 0) FROM queue;

put:
INSERT OR REPLACE INTO queue (episode_id, sort_key) VALUES (?, ?);

remove:
DELETE FROM queue WHERE episode_id = ?;

first:
SELECT episode_id FROM queue ORDER BY sort_key LIMIT 1;
