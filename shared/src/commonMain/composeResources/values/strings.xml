    <string name="privacy_ua_ok">Already minimal</string>
    <string name="pv_hosts_tip">Refreshing less often in the background tells less about when you are online.</string>
    <string name="pv_pi_tip">If you know a show's feed address, enter it directly: then Hopp does not search.</string>
    <string name="pv_directories_tip">Leave them off unless you need them.</string>
    <string name="pv_sc_tip">Leave your name empty and a payment stays anonymous. Without a Nostr identity — or with “Vote and suggest anonymously” on — votes are anonymous too.</string>
    <string name="pv_wallet_tip">With your own node or your own relay, your payments stay with you.</string>
    <string name="pv_recipients_tip">Leave your name empty and you boost anonymously.</string>
    <string name="pv_extra_tip">A VPN helps here too (see above).</string>
    <string name="pv_share_who">Whoever opens a link you share</string>
    <string name="pv_share_sees">the show, the episode and the time in the link — nothing about you; www.sovereigncast.space sees their IP address if they open it in a browser</string>
