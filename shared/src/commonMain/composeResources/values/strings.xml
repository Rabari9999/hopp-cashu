    <string name="privacy_title">Privacy</string>
    <string name="settings_privacy">Privacy · who sees what</string>
    <string name="privacy_intro">Hopp collects nothing itself: no account, no analytics, no tracking, no Hopp server that sees what you listen to. But Hopp talks to others for you — here is who they are and what they see.</string>
    <string name="privacy_who_title">Who sees what</string>
    <string name="privacy_sees">Sees: %1$s</string>
    <string name="privacy_when">When: %1$s</string>
    <string name="pv_hosts_who">Feed hosts (PodHome, self-hosted instances, …)</string>
    <string name="pv_hosts_sees">your IP address, the User-Agent, which episode is fetched</string>
    <string name="pv_hosts_when">every refresh, stream and download</string>
    <string name="pv_pi_who">Podcast Index</string>
    <string name="pv_pi_sees">your search terms and your IP address</string>
    <string name="pv_pi_when">when you search or open recommendations</string>
    <string name="pv_directories_who">fyyd and Apple Podcasts</string>
    <string name="pv_directories_sees">your search terms and your IP address</string>
    <string name="pv_directories_when">only if you switch them on in the settings</string>
    <string name="pv_sc_who">Sovereigncast instances of a show</string>
    <string name="pv_sc_sees">your IP address, which show you view; your name and message if you add them to a payment; your Nostr identity on votes and suggestions if you have one</string>
    <string name="pv_sc_when">community features: Release Boosting, Boost2Unlock, suggestions, votes, boosts</string>
    <string name="pv_wallet_who">Your wallet and its NWC relay</string>
    <string name="pv_wallet_sees">every payment you make</string>
    <string name="pv_wallet_when">boosts and streaming</string>
    <string name="pv_recipients_who">Boost recipients</string>
    <string name="pv_recipients_sees">episode, playback position, message and — if given — your name; Hopp's support address only the amount, and only if you switch it on</string>
    <string name="pv_recipients_when">with each boost, as Podcasting 2.0 apps send it</string>
    <string name="pv_extra_who">Hosts of images, chapters and transcripts</string>
    <string name="pv_extra_sees">your IP address</string>
    <string name="pv_extra_when">when they load; the addresses come from the feed</string>
    <string name="pv_backup_who">Google (system backup)</string>
    <string name="pv_backup_sees">your library, positions, settings and payment history</string>
    <string name="pv_backup_when">only if system backups are on for your device</string>
    <string name="privacy_ua_title">What Hopp says about itself</string>
    <string name="privacy_ua">Every request carries “%1$s” — app, platform and device class, enough for podcasters' statistics. No system version, no device model.</string>
    <string name="privacy_backup_title">What never leaves your device</string>
    <string name="privacy_backup">The wallet connection is kept in the system's key store and is never part of a backup. Downloaded episodes are not backed up either; they can be downloaded again.</string>
    <string name="privacy_summary">%1$d of %2$d points Hopp can check are optimised</string>
    <string name="privacy_ip_title">Your IP address</string>
    <string name="privacy_ip">Almost everyone below sees your IP address, which roughly tells where you are. A VPN or Tor (Orbot in VPN mode, for instance) hides it. Hopp only checks that one is active, not whom you trust with it.</string>
